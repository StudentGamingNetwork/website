{
    "extends": "./tsconfig.json",
     "compilerOptions": {
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts"],
    "exclude": [
        "node_modules",
        "dist",
        "src/database/test/*.ts",
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "src/**/*.test.tsx",
        "src/**/*.spec.tsx",
        "src/**/__tests__/**"
    ]
}